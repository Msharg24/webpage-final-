{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ABCode Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/abcode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/abcode-extension/out/**/*.js"
      ]
    }
  ]
}

